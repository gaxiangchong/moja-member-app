# Dependencies (large)
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Environment & secrets — never commit
.env
.env.*
!.env.example
# Member web production build config — public URLs only, safe to commit.
!client-web/.env.production

# Local import/export files (repo root only — not **/data/ e.g. client-web/src/shop/data)
/data/

# Logs & runtime
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test / coverage
coverage/
.nyc_output/

# Prisma (client is under node_modules; keep migrations committed)
# Uncomment if you ever generate SQL dumps locally:
# *.sql~

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDEs / editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# Debug
.debug/

# Optional local tooling
.eslintcache
