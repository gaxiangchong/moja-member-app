# For local PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/moja_member?schema=public"

# Alternative Prisma Postgres (cloud)
# DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"
# DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"
JWT_SECRET="generate-a-long-random-string"
JWT_EXPIRES_IN_SEC=604800
PHONE_DEFAULT_REGION="SG"
OTP_TTL_MINUTES=10
OTP_REQUEST_WINDOW_MINUTES=15
OTP_MAX_REQUESTS_PER_WINDOW=3

# OTP delivery mode:
# - auto: use WhatsApp if configured, otherwise dev/mock response
# - mock: always return OTP in API response (for testing)
# - whatsapp: require WhatsApp config, otherwise fail
OTP_DELIVERY_MODE=mock
# Optional fixed OTP code in mock mode (handy for demos/tests)
OTP_MOCK_FIXED_CODE=123456
ADMIN_API_KEYS="comma-separated-admin-keys"
# Admin UI JWT (Bearer). If unset, JWT_SECRET is used. typ=admin in payload.
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES_IN_SEC=604800
# First-time setup: POST /admin/auth/bootstrap with email/password when admin_users is empty.
# Set to true only for trusted operators; phone changes are audited separately.
ADMIN_ALLOW_PHONE_CHANGE=false
# Comma-separated voucher codes that support may assign via POST /admin/customers/:id/vouchers/goodwill
# SUPPORT_GOODWILL_VOUCHER_CODES=GOODWILL5,COMP10
PORT=3153

# --- Xendit Payments API (v3 payment_requests) — wallet top-up & future flows
# @see https://docs.xendit.co/docs/how-payments-api-work
# XENDIT_SECRET_KEY=
# Webhook URL: POST {PUBLIC_API}/webhooks/xendit — set the same token in the Xendit dashboard
# XENDIT_WEBHOOK_TOKEN=
# XENDIT_COUNTRY=MY
# XENDIT_CURRENCY=MYR
# Channel list depends on country; examples: TOUCHNGO, SHOPEEPAY, GCASH (PH)
# CARDS requires extra backend/frontend implementation (card_details/tokenization), so keep it out for now.
# XENDIT_DEFAULT_CHANNEL_CODE=TOUCHNGO
# Comma-separated PAY channels for Shop checkout (member picks one; must match Xendit test dashboard).
# XENDIT_SHOP_CHANNEL_CODES=TOUCHNGO,SHOPEEPAY,FPX
# Card checkout in this app uses payment_token_id (tokenized flow), not raw PAN/card_details through backend.
# When true, checkout skips Xendit (no TNG/e-wallet page). Simulate a successful payment via
#   POST /payments/demo/complete-shop-order        (Shop orders)
#   POST /payments/demo/complete-bento-subscription (Bento plans -> flips to ACTIVE so you can schedule)
# The bento web app auto-detects this: checkout shows "Continue (demo)" and proceeds straight to booking.
# Leave it off (or unset) to test the real flow — an unpaid plan then shows the "complete your payment" notice.
# PAYMENTS_DEMO_MODE=true
# Optional override for success/failure redirects (defaults to first CLIENT_WEB_ORIGIN)
# MEMBER_APP_PUBLIC_URL=http://localhost:5193
# Required for card tokenization via Xendit Components: HTTPS origins only (comma-separated)
# XENDIT_COMPONENTS_ORIGINS=https://your-https-member-web.example
# XENDIT_API_BASE=https://api.xendit.co
# XENDIT_API_VERSION=2024-11-11

# CORS: comma-separated origins for member web, ops queue, and bento web.
# BENTO_APP_PUBLIC_URL / MEMBER_APP_PUBLIC_URL / SHOP_WEB_BASE_URL are also merged into CORS automatically.
CLIENT_WEB_ORIGIN=http://localhost:5193,http://localhost:5194,http://localhost:5195

# Public URL for bento-web payment redirects (defaults to http://localhost:5195)
# BENTO_APP_PUBLIC_URL=http://localhost:5195
# Set to false to hide drink add-ons and dinner soup surcharges until you can offer them
# BENTO_DRINKS_AND_SOUP_ENABLED=false
# Max lunch + dinner packs per calendar day (overrides data/bento-settings.json when set)
# BENTO_DAILY_CAPACITY_PACKS=50
# Bento schedule rules (data/bento-settings.json): earliestPickupDate, minScheduleLeadDays, closedDates[]
# Weekday closed days are configured per row in admin → Bento weekly menu (Closed column).

# Kitchen / operations queue API (header: x-ops-api-key). Used by ops-queue-web.
OPS_QUEUE_API_KEY=change-me-ops-queue-secret

# Feature flags (true/1/on/yes to enable)
FEATURE_SHOP_SSO=false
FEATURE_CAMPAIGN_ASYNC=false

# Shop SSO handoff (member API issues JWT; shop site verifies at /sso/consume)
# SHOP_WEB_BASE_URL: public shop site origin (used to build https://origin/sso/consume?handoff=...)
SHOP_WEB_BASE_URL=http://localhost:3000
# Issuer claim must match what the shop validates (often your member API public base URL)
SHOP_HANDOFF_ISSUER=http://localhost:3153
SHOP_HANDOFF_AUDIENCE=shop
# Optional; defaults to JWT_SECRET if unset
# SHOP_HANDOFF_JWT_SECRET=
SHOP_HANDOFF_TTL_SEC=45

# Shop site → member app cart handoff (checkout redirect from moja-sites)
# Uses SHOP_HANDOFF_JWT_SECRET / JWT_SECRET if SHOP_CART_HANDOFF_JWT_SECRET is unset
# SHOP_CART_HANDOFF_JWT_SECRET=
# SHOP_CART_HANDOFF_ISSUER=http://localhost:3153
# SHOP_CART_HANDOFF_AUDIENCE=member_app_cart
# SHOP_CART_HANDOFF_TTL_SEC=300

# Shop catalog sync (admin dashboard → Settings · Shopping catalog → Sync from moja-sites)
# Default path: ../moja-sites/config/products.catalog.json (sibling repo on dev machines)
# MOJA_SITES_CATALOG_PATH=/path/to/products.catalog.json
# MOJA_SITES_CATALOG_URL=https://your-shop-site.example/config/products.catalog.json

# --- WhatsApp OTP provider selector (used only for first-time registration and forgot-PIN) ---
# Choose which transport delivers the OTP. Default is `meta`.
#   meta   — Meta WhatsApp Cloud API (Graph API)
#   twilio — Twilio Programmable Messaging on the WhatsApp channel
# WHATSAPP_PROVIDER=twilio

# WhatsApp Cloud API (Meta) — required when WHATSAPP_PROVIDER=meta
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_API_VERSION=v21.0
# Optional: approved template with {{1}} = OTP code in the body
# WHATSAPP_OTP_TEMPLATE_NAME=
# WHATSAPP_OTP_TEMPLATE_LANG=en
# Meta authentication (copy-code / one-tap) templates require the code in body + button.
# Default is true when WHATSAPP_OTP_TEMPLATE_NAME is set. Set false for body-only utility templates.
# WHATSAPP_OTP_META_INCLUDE_AUTH_BUTTON=true

# Twilio WhatsApp — required when WHATSAPP_PROVIDER=twilio
# Get Account SID and Auth Token from https://console.twilio.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Sender: use EITHER a WhatsApp-enabled number OR a Messaging Service SID.
# Twilio Sandbox default sender is whatsapp:+14155238886 (recipients must join first).
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_MESSAGING_SERVICE_SID=
# Optional: pre-approved Content template SID for production. {{1}} = OTP code.
# TWILIO_WHATSAPP_CONTENT_SID=

# --- SalesPlay POS integration ---
# Inbound: POST /webhooks/salesplay?token=<SALESPLAY_WEBHOOK_TOKEN> (receipts → loyalty points)
# Outbound: member registration syncs customers; paid shop orders push via online_orders API.
# SALESPLAY_ENABLED=true
# Access token from SalesPlay Backoffice → Integrations → Access Token
# SALESPLAY_ACCESS_TOKEN=
# Shared secret for webhook URL query param (SalesPlay does not sign webhooks)
# SALESPLAY_WEBHOOK_TOKEN=
# Loyalty earn rate (points per RM spent). Legacy fallback: SALESPLAY_POINTS_PER_UNIT
# LOYALTY_POINTS_PER_RM=1
# Optional API base override (default https://api.salesplaypos.com/v1.0)
# SALESPLAY_API_BASE=
# SALESPLAY_DEFAULT_COUNTRY=Malaysia
# Online shop orders → SalesPlay (requires SALESPLAY_SHOP_ID from SalesPlay Backoffice)
# SALESPLAY_ONLINE_ORDERS_ENABLED=true
# SALESPLAY_SHOP_ID=
# Order type label in SalesPlay (e.g. Pickup, Delivery)
# SALESPLAY_ORDER_TYPE=Pickup
# Payment type name as configured in SalesPlay (must match POS payment type)
# SALESPLAY_PAYMENT_TYPE=Online
# Optional terminal id to route the order to a specific POS terminal
# SALESPLAY_TARGET_TERMINAL=
# Product codes on order lines use member-app productId — align with SalesPlay product_code.
# Pull sync / reconciliation (recommended ON in production — webhooks are the
# primary feed; the pull is the integrity net that catches missed webhooks).
# SALESPLAY_PULL_ENABLED=true
# SALESPLAY_RECONCILE_ENABLED=true
# SALESPLAY_RECONCILE_INTERVAL_HOURS=24
# SALESPLAY_RECONCILE_LOOKBACK_DAYS=3
# One-time backfill start date (defaults to salesStartDate reporting cutoff)
# SALESPLAY_BACKFILL_FROM=
# SALESPLAY_PULL_PAGE_SIZE=250


# --- Marketing email mailer (admin dashboard → Email marketing) ---
# Campaign sends reuse the Resend key + from address configured for OTP/receipts
# (RESEND_API_KEY, OTP_EMAIL_FROM / RECEIPT_EMAIL_FROM).
# Optional dedicated marketing from-address — strongly recommended on a
# separate subdomain so campaign volume never hurts OTP deliverability.
# MARKETING_EMAIL_FROM="Moja Maison <news@updates.example.com>"
# Public base URL of THIS API, used to build unsubscribe links in email
# footers. Required for compliant marketing sends (e.g. https://api.example.com).
# API_PUBLIC_URL=http://localhost:3153
