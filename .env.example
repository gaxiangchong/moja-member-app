# For local PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/moja_member?schema=public"

# Alternative Prisma Postgres (cloud)
# DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"
# DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"
JWT_SECRET="generate-a-long-random-string"
JWT_EXPIRES_IN_SEC=604800
PHONE_DEFAULT_REGION="SG"
OTP_TTL_MINUTES=10
OTP_REQUEST_WINDOW_MINUTES=15
OTP_MAX_REQUESTS_PER_WINDOW=3

# OTP delivery mode:
# - auto: use Email OTP if configured, else Twilio Verify, else SMS, else WhatsApp, otherwise dev/mock response
# - mock: always return OTP in API response (for testing)
# - verify: use Twilio Verify (Twilio generates/sends/checks the code), otherwise fail
# - sms: require Twilio SMS config, otherwise fail
# - whatsapp: require WhatsApp config, otherwise fail
# - email: require Resend email OTP config, otherwise fail
OTP_DELIVERY_MODE=mock
# Optional fixed OTP code in mock mode (handy for demos/tests)
OTP_MOCK_FIXED_CODE=123456
# Resend email OTP (required for OTP_DELIVERY_MODE=email or auto with email available)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
# OTP_EMAIL_FROM=Moja Maison <otp@yourdomain.com>
# OTP_EMAIL_SUBJECT_PREFIX=Moja Maison
# Transactional receipts (shop orders & wallet top-ups). Reuses RESEND_API_KEY.
# Both keys are optional — RECEIPT_EMAIL_FROM falls back to OTP_EMAIL_FROM,
# RECEIPT_EMAIL_SUBJECT_PREFIX falls back to OTP_EMAIL_SUBJECT_PREFIX.
# Set them if you want receipts to come from a different sender, e.g. receipts@.
# RECEIPT_EMAIL_FROM=Moja Maison <receipts@yourdomain.com>
# RECEIPT_EMAIL_SUBJECT_PREFIX=Moja Maison
ADMIN_API_KEYS="comma-separated-admin-keys"
# Admin UI JWT (Bearer). If unset, JWT_SECRET is used. typ=admin in payload.
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES_IN_SEC=604800
# First-time setup: POST /admin/auth/bootstrap with email/password when admin_users is empty.
# Set to true only for trusted operators; phone changes are audited separately.
ADMIN_ALLOW_PHONE_CHANGE=false
# Comma-separated voucher codes that support may assign via POST /admin/customers/:id/vouchers/goodwill
# SUPPORT_GOODWILL_VOUCHER_CODES=GOODWILL5,COMP10
PORT=3153

# --- Xendit Payments API (v3 payment_requests) — wallet top-up & future flows
# @see https://docs.xendit.co/docs/how-payments-api-work
# XENDIT_SECRET_KEY=
# Webhook URL: POST {PUBLIC_API}/webhooks/xendit — set the same token in the Xendit dashboard
# XENDIT_WEBHOOK_TOKEN=
# XENDIT_COUNTRY=MY
# XENDIT_CURRENCY=MYR
# Channel list depends on country; examples: TOUCHNGO, SHOPEEPAY, GCASH (PH)
# CARDS requires extra backend/frontend implementation (card_details/tokenization), so keep it out for now.
# XENDIT_DEFAULT_CHANNEL_CODE=TOUCHNGO
# Comma-separated PAY channels for Shop checkout (member picks one; must match Xendit test dashboard).
# Note: SHOPEEPAY is hidden from the member checkout UI by the frontend even
# if listed here. Recommend removing it from this list as well for consistency.
# XENDIT_SHOP_CHANNEL_CODES=TOUCHNGO,FPX
# Card checkout in this app uses payment_token_id (tokenized flow), not raw PAN/card_details through backend.
# When true, shop checkout skips Xendit; use POST /payments/demo/complete-shop-order to finish test orders.
# PAYMENTS_DEMO_MODE=true
# Optional override for success/failure redirects (defaults to first CLIENT_WEB_ORIGIN)
# MEMBER_APP_PUBLIC_URL=http://localhost:5193
# Required for card tokenization via Xendit Components: HTTPS origins only (comma-separated)
# XENDIT_COMPONENTS_ORIGINS=https://your-https-member-web.example
# XENDIT_API_BASE=https://api.xendit.co
# XENDIT_API_VERSION=2024-11-11

# --- Loyalty points economy (universal — same wallet for in-store + online shop) ---
# Two knobs together define the economy:
#   1) EARN RATE — this env: points credited per RM spent. Applies to BOTH
#      SalesPlay POS receipts (/webhooks/salesplay) and member-app shop orders
#      paid via Xendit. Formula: floor(floor(totalCents / 100) * this_rate).
#   2) REDEEM VALUE — set per reward in the Reward Catalog (admin dashboard):
#      each catalog entry's pointsCost ↔ voucher valueCents fixes "1 pt = RM x".
#
# Default 1 (RM 1 = 1 pt, redeemed at whatever ratio the catalog defines).
#
# Examples:
#   • 1 pt = RM 1.00, 1% cashback  → LOYALTY_POINTS_PER_RM=0.01 (catalog 1:100)
#   • 1 pt = RM 0.10, 5% cashback  → LOYALTY_POINTS_PER_RM=0.5  (catalog 1:10)
#   • 1 pt = RM 0.01, 5% cashback  → LOYALTY_POINTS_PER_RM=5    (catalog 1:1)
#
# Caveat with fractional rates (e.g. 0.5): receipts under RM 2 floor to 0 pts.
# Typical café/bakery receipts (RM 20+) are unaffected.
# LOYALTY_POINTS_PER_RM=1

# Referral reward: loyalty points granted to the REFERRER when a member they
# referred completes their FIRST paid order. Default 0 = disabled (referrals are
# still tracked, just no automatic points). Set a whole number to enable.
# Example: reward the referrer 100 points per successful referral.
# REFERRAL_REWARD_POINTS=100

# Birthday gift: loyalty points credited to a member during their BIRTHDAY MONTH,
# at most once per calendar year. Default 0 = disabled. Granted lazily the next
# time the member opens their profile (or updates their birthday) during that
# month — no scheduler needed.
# Example: 150 points birthday gift.
# BIRTHDAY_REWARD_POINTS=150

# CORS: comma-separated origins for the member web app (5193) and ops queue display (5194)
CLIENT_WEB_ORIGIN=http://localhost:5193,http://localhost:5194

# Kitchen / operations queue API (header: x-ops-api-key). Used by ops-queue-web.
OPS_QUEUE_API_KEY=change-me-ops-queue-secret

# Feature flags (true/1/on/yes to enable)
FEATURE_SHOP_SSO=false
FEATURE_CAMPAIGN_ASYNC=false

# Shop SSO handoff (member API issues JWT; shop site verifies at /sso/consume)
# SHOP_WEB_BASE_URL: public shop site origin (used to build https://origin/sso/consume?handoff=...)
SHOP_WEB_BASE_URL=http://localhost:3000
# Issuer claim must match what the shop validates (often your member API public base URL)
SHOP_HANDOFF_ISSUER=http://localhost:3153
SHOP_HANDOFF_AUDIENCE=shop
# Optional; defaults to JWT_SECRET if unset
# SHOP_HANDOFF_JWT_SECRET=
SHOP_HANDOFF_TTL_SEC=45

# Shop site → member app cart handoff (checkout redirect from moja-sites)
# Uses SHOP_HANDOFF_JWT_SECRET / JWT_SECRET if SHOP_CART_HANDOFF_JWT_SECRET is unset
# SHOP_CART_HANDOFF_JWT_SECRET=
# SHOP_CART_HANDOFF_ISSUER=http://localhost:3153
# SHOP_CART_HANDOFF_AUDIENCE=member_app_cart
# SHOP_CART_HANDOFF_TTL_SEC=300

# Shop catalog sync (admin dashboard → Shopping catalog → Sync from moja-sites)
# Production (Render): upload products.catalog.json once in the admin UI → saved to data/products.catalog.json on your disk.
# Or set a public URL (overrides local file when fetch succeeds):
# MOJA_SITES_CATALOG_URL=https://your-shop-site.example/config/products.catalog.json
# Or auto-fetch from shop site when SHOP_WEB_BASE_URL is set (tries {SHOP_WEB_BASE_URL}/config/products.catalog.json):
# SHOP_WEB_BASE_URL=https://shop.example.com
# Local dev: sibling ../moja-sites/config/products.catalog.json is used when present.
# MOJA_SITES_CATALOG_PATH=/absolute/path/to/products.catalog.json

# --- WhatsApp OTP provider selector (used only for first-time registration and forgot-PIN) ---
# Choose which transport delivers the OTP. Default is `meta`.
#   meta   — Meta WhatsApp Cloud API (Graph API)
#   twilio — Twilio Programmable Messaging on the WhatsApp channel
# WHATSAPP_PROVIDER=twilio

# WhatsApp Cloud API (Meta) — required when WHATSAPP_PROVIDER=meta
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_API_VERSION=v21.0
# Optional: approved template with {{1}} = OTP code in the body
# WHATSAPP_OTP_TEMPLATE_NAME=
# WHATSAPP_OTP_TEMPLATE_LANG=en
# Meta authentication (copy-code / one-tap) templates require the code in body + button.
# Default is true when WHATSAPP_OTP_TEMPLATE_NAME is set. Set false for body-only utility templates.
# WHATSAPP_OTP_META_INCLUDE_AUTH_BUTTON=true

# Twilio WhatsApp — required when WHATSAPP_PROVIDER=twilio
# Get Account SID and Auth Token from https://console.twilio.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Sender: use EITHER a WhatsApp-enabled number OR a Messaging Service SID.
# Twilio Sandbox default sender is whatsapp:+14155238886 (recipients must join first).
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_MESSAGING_SERVICE_SID=
# Optional: pre-approved Content template SID for production. {{1}} = OTP code.
# TWILIO_WHATSAPP_CONTENT_SID=

# --- SalesPlay POS integration ---
# When enabled, newly registered members (and profile updates) are pushed to the
# SalesPlay customer base. Non-blocking: a SalesPlay outage never breaks signup.
# SALESPLAY_ENABLED=true
# Personal access token: SalesPlay Backoffice → Integrations → Access Token (API keys).
# SALESPLAY_ACCESS_TOKEN=
# SALESPLAY_API_BASE=https://api.salesplaypos.com/v1.0
# Default country sent on the customer record.
# SALESPLAY_DEFAULT_COUNTRY=Malaysia
# By default SalesPlay auto-generates the customer code. Set true to send our referral code instead.
# SALESPLAY_SEND_CODE=false
# Inbound webhook: SalesPlay receipts → loyalty points. Secret is checked as ?token= on
# the webhook URL (SalesPlay does not sign requests). URL: /webhooks/salesplay?token=...
# SALESPLAY_WEBHOOK_TOKEN=
# Legacy: points awarded per 1 unit of currency spent in store (default 1).
# Prefer LOYALTY_POINTS_PER_RM below — it covers both in-store and online.
# If both are set, LOYALTY_POINTS_PER_RM wins.
# SALESPLAY_POINTS_PER_UNIT=1

# Twilio Verify — required when OTP_DELIVERY_MODE=verify (or auto with Verify preferred)
# Reuses TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN above.
# Service SID starts with VA (Console → Verify → Services).
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio SMS — required when OTP_DELIVERY_MODE=sms (or auto with SMS preferred)
# Reuses TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN above.
# TWILIO_SMS_FROM=+1234567890
# Or use a Messaging Service that includes an SMS-capable sender:
# TWILIO_MESSAGING_SERVICE_SID=

