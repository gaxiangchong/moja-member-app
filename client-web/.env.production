# Production build env for the member web app (Render Static Site).
# Vite bakes VITE_* into the bundle at `npm run build` — change here, then rebuild.

# Member API origin (no trailing slash).
VITE_API_BASE_URL=https://api.mojamaison.com

# Shop site origin — product/popular images are loaded from here.
# Must be the ORIGIN only (no /shop path); the app appends /images/products/...
VITE_SHOP_WEB_URL=https://mojamaison.com

# Enable only when shop SSO is wired end-to-end in production.
VITE_FEATURE_SHOP_SSO=false
