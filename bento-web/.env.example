VITE_API_BASE_URL=http://localhost:3153

# Weekly menu meal photos.
# Default (unset or anything other than "true") = OFF -> compact text-only cards.
# Set to true to show meal photos on the menu cards.
VITE_MENU_SHOW_IMAGES=false

# Customer support WhatsApp (digits only, no +). Used on login and account pages.
VITE_WHATSAPP_NUMBER=601139331134

# Vegetarian meal option.
# Default (unset or anything other than "true") = OFF -> veg choices are shown
# as unavailable and cannot be selected. Set to true to offer vegetarian meals.
VITE_VEG_OPTION_ENABLED=false

# Auth OTP is sent by the API (repo root .env), not here.
# Use email OTP (same as Moja member app):
#   OTP_DELIVERY_MODE=email
#   RESEND_API_KEY=...
#   OTP_EMAIL_FROM=...

# Payment bypass is controlled on the API (repo root .env), not here:
# PAYMENTS_DEMO_MODE=true
# Disabling checkout entirely is also controlled on the API (repo root .env):
# PAYMENTS_DISABLED=true
